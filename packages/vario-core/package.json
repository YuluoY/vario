{
  "name": "@variojs/core",
  "version": "0.1.9",
  "description": "Vario Core Runtime - Instruction VM, Expression System, Runtime Context",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/runtime.js",
      "types": "./dist/runtime.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    },
    "./expression": {
      "import": "./dist/expression.js",
      "types": "./dist/expression.d.ts"
    },
    "./vm": {
      "import": "./dist/vm.js",
      "types": "./dist/vm.d.ts"
    },
    "./schema-tools": {
      "import": "./dist/schema-tools.js",
      "types": "./dist/schema-tools.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.23.6",
    "@babel/types": "^7.23.6",
    "@variojs/types": "workspace:*"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.8",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}