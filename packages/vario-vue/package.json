{
  "name": "@variojs/vue",
  "version": "0.6.0",
  "description": "Vario Vue Renderer - Vue 3 integration for Vario Schema rendering",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins.js",
      "types": "./dist/plugins.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:perf": "NODE_OPTIONS=--max-old-space-size=8192 vitest run __tests__/performance.test.ts",
    "test:comprehensive": "NODE_OPTIONS=--max-old-space-size=4096 vitest run __tests__/model-path-comprehensive.test.ts",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "element-plus": "^2.4.0",
    "happy-dom": "^20.12.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "vue": "^3.4.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@variojs/core": "workspace:*",
    "@variojs/schema": "workspace:*",
    "@variojs/types": "workspace:*"
  }
}
